rules_version = '2';

// chicode 접근 규칙.
//
// 여기가 실제 방어선이다. 프론트엔드에서 버튼을 숨기는 것은 편의일 뿐이고,
// 브라우저 코드를 아무리 고쳐도 이 규칙을 우회할 수 없다.
service cloud.firestore {
  match /databases/{database}/documents {

    // Google 로그인에 성공했다고 교사가 되는 것이 아니다.
    // teachers 컬렉션에 해당 이메일 문서가 있어야 한다.
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/teachers/$(request.auth.token.email));
    }

    // 교사 목록: 로그인한 사람이 '자기 자신'의 등록 여부만 확인할 수 있다.
    // 목록 전체 조회를 막아 교사 이메일이 새어나가지 않게 한다.
    // 추가·삭제는 Firebase 콘솔에서만 한다.
    match /teachers/{teacherEmail} {
      allow get: if request.auth != null && teacherEmail == request.auth.token.email;
      allow list, create, update, delete: if false;
    }

    // 수업자료 과목(정보, 인공지능 기초 …): 이름·핀·노션 링크를 담는다.
    // 핀은 여기서도 "가벼운 잠금" 이다 — 읽기를 열어두지 않으면 학생 화면이
    // 과목 이름조차 못 띄우므로, 핀 값도 함께 공개된다. 진짜 보안이 필요하면
    // Cloud Functions 로 검증하는 구조로 바꿔야 한다(현재는 무료 플랜이라 제외).
    match /subjects/{subjectId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // 수업자료: 학생은 로그인이 없으므로 읽기는 열어둔다. 쓰기는 교사만.
    match /materials/{materialId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();

      // 파일 내용 조각. 규칙은 하위 컬렉션으로 자동 상속되지 않으므로 따로 적어야 한다.
      // 여기를 빠뜨리면 파일 본문이 무방비로 열린다.
      match /chunks/{chunkIndex} {
        allow read: if true;
        allow create, update, delete: if isTeacher();
      }
    }

    // 오늘의 AI·IT 이슈 — 후보(자동 수집, 아직 학생에게 비공개).
    //
    // 매일 아침 GitHub Actions가 Firebase Admin SDK로 이 컬렉션에 쓴다. Admin SDK는
    // 이 규칙 자체를 우회하므로 아래에서 create/update를 막아도 자동화는 그대로
    // 동작한다 — 여기서 막는 대상은 "클라이언트에서 가짜 후보를 써넣는 것"이다.
    // 원문을 그대로 모아둔 검증 전 자료라 학생에게는 보여주지 않는다(교사만 읽기).
    // 교사가 "건너뛰기"를 누르면 지워야 하니 delete만은 교사에게 열어준다.
    match /newsCandidates/{candidateId} {
      allow read, delete: if isTeacher();
      allow create, update: if false;
    }

    // 오늘의 AI·IT 이슈 — 발행본. 교사가 후보를 검토해 요약·왜 중요한가를 직접 쓰고
    // 승인한 것만 여기 들어간다(자동 발행 아님 — LLM 요약 비용을 안 쓰기로 한 대신
    // 사람이 판단한다는 트레이드오프). materials와 같은 패턴 — 학생은 로그인이
    // 없으므로 읽기는 공개, 쓰기(발행·수정·삭제)는 교사만.
    match /newsIssues/{issueId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // CHICODE LAB(동아리 활동) — subjects/materials 와 동일한 패턴이다.
    // 학생은 로그인이 없으므로 읽기는 열어두고, 쓰기는 교사만 허용한다.
    match /labs/{labId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // Roadmap 카드(시즌).
    match /labSeasons/{seasonId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // Lab 홈 화면 설정. 문서 하나("home")만 쓰는 싱글턴이다.
    match /labSettings/{settingsId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // 실습(Pico 2 W) 공개 여부. 문서 하나("pico2w")만 쓰는 싱글턴 —
    // labSettings 와 같은 패턴이다. 학생은 로그인이 없으므로 읽기는 열어두고
    // (닫혀 있으면 프론트엔드가 ComingSoon 을 보여준다), 여닫는 건 교사만.
    match /practiceSettings/{settingsId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // Lab 활동에 첨부하는 발표자료(PPT 원본 + 대체용 PDF). materials 와 같은
    // 조각 저장 구조(chunkedFile.ts)를 쓰므로 규칙도 같은 모양이다. 학생
    // 화면은 뷰어로만 보여주고 다운로드 링크를 만들지 않지만, 그건 프론트엔드
    // 배려일 뿐 — read: true 인 이상 파일 내용 자체는 공개다(subjects/materials
    // 와 같은 "가벼운 잠금" 트레이드오프, 진짜 방지가 필요하면 Blaze 필요).
    match /labSlides/{activityId} {
      // 이 문서 자체는 대본(notes 배열)만 담는다. 교사가 발표 중에 실시간으로
      // 고치므로 학생 읽기는 열어두고, 쓰기는 교사만 허용한다.
      allow read: if true;
      allow create, update, delete: if isTeacher();

      match /files/{fileId} {
        allow read: if true;
        allow create, update, delete: if isTeacher();

        match /chunks/{chunkIndex} {
          allow read: if true;
          allow create, update, delete: if isTeacher();
        }
      }
    }

    // 발표 모드 실시간 상태(현재 슬라이드 번호). 학생은 로그인이 없어 반/교실을
    // 구분할 방법이 없으므로 활동 하나당 전역으로 하나만 둔다(labPresentation.ts
    // 주석 참고 — 사용자가 확인하고 받아들인 트레이드오프). 슬라이드를 넘기는
    // 건 교사만 할 수 있어야 하므로 쓰기는 isTeacher()로 막는다 — 여기가 실제
    // 방어선이다, 프론트엔드에서 버튼을 숨기는 건 편의일 뿐.
    match /labPresentations/{activityId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();
    }

    // 교사 시간표(요일 x 교시). 학생에게 보여줄 이유가 없는 업무용 정보(반 이름,
    // 교실 등)라 subjects/materials 와 달리 읽기도 isTeacher() 로 막는다 — "가벼운
    // 잠금"이 아니라 진짜로 로그인한 교사만 볼 수 있다. 문서 하나("default")만
    // 쓰는 싱글턴(labSettings 와 같은 패턴).
    match /timetable/{docId} {
      allow read, write: if isTeacher();
    }

    // 활동 항목(section) 하나하나에 붙는 첨부파일(이미지·PDF·PPT·엑셀).
    // labSlides 와 같은 조각 저장 구조지만, 다운로드를 막을 이유가 없는
    // 일반 수업자료라 성격은 materials 에 더 가깝다.
    match /labSectionFiles/{activityId}/files/{fileId} {
      allow read: if true;
      allow create, update, delete: if isTeacher();

      match /chunks/{chunkIndex} {
        allow read: if true;
        allow create, update, delete: if isTeacher();
      }
    }
  }
}
