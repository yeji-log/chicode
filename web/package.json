{
  "name": "chicode-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --base=/chicode/ && cp dist/index.html dist/404.html",
    "lint": "oxlint",
    "preview": "vite preview",
    "sync:pyodide": "node scripts/sync-pyodide.mjs",
    "postinstall": "node scripts/sync-pyodide.mjs && node scripts/sync-clang.mjs && node scripts/sync-micropython.mjs && node scripts/sync-pdfjs-assets.mjs",
    "sync:clang": "node scripts/sync-clang.mjs",
    "sync:micropython": "node scripts/sync-micropython.mjs",
    "sync:pdfjs-assets": "node scripts/sync-pdfjs-assets.mjs",
    "fetch:news": "node scripts/fetch-news.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/jua": "^5.3.0",
    "@micropython/micropython-webassembly-pyscript": "^1.28.0-6",
    "@monaco-editor/react": "^4.7.0",
    "firebase": "^12.17.1",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^6.2.108",
    "pptx-preview": "^1.0.7",
    "prismjs": "^1.30.0",
    "pyodide": "^314.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.27.0",
    "oxlint": "^1.75.0",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
