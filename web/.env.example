# Firebase 웹 앱 설정. 실제 값은 .env.local 에 두며 git 에 올리지 않는다.
# 콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱 에서 확인할 수 있다.
#
# 이 값들은 비밀이 아니다. 빌드되면 브라우저에 그대로 노출되는 공개 설정값이고,
# 실제 접근 통제는 firestore.rules / storage.rules 가 담당한다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
